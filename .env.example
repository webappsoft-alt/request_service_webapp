# Copy into Netlify → Site settings → Environment variables (Production + Preview).
# Do not commit real secrets into git.

NEXT_PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app
NEXT_PUBLIC_API_BASE_URL=https://qqa.binsapp.ai/api

# Optional SEO / maps (same keys you use locally)
NEXT_PUBLIC_MAPS_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAPBOX_PLACES_API_KEY=
# Server-only Places key (required on Netlify). Do not use NEXT_PUBLIC_ for this —
# Netlify redacts public env values out of uploaded JS/functions.
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ENCRYPTION_KEY=
